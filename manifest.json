{
  "manifest_version": 3,
  "name": "Moodle Proctor",
  "version": "1.3.0",
  "description": "Browser lock, extra-display detection, leaving-the-browser detection and AI-tab blocking for Moodle Proctor.",
  "permissions": [
    "tabs",
    "system.display"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/mod/quiz/attempt.php*",
        "*://*/mod/quiz/view.php*",
        "*://*/course/view.php*",
        "*://*/local/moodle_proctor/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Moodle Proctor"
}
